# Backend configuration. All values are optional; the defaults are shown. There are no secrets.
RECRUIT_RADAR_DB_PATH=backend/data/recruit_radar.sqlite3
RECRUIT_RADAR_HOST=127.0.0.1
RECRUIT_RADAR_PORT=8787
RECRUIT_RADAR_CORS_ORIGINS=http://localhost:5173,http://localhost:4174
RECRUIT_RADAR_MIN_REFRESH_INTERVAL_S=60
