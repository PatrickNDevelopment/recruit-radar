    {
      "id": "norm_text-012",
      "fn": "norm_text",
      "input": "\u0131stanbul",
      "expected": "\u0131stanbul",
      "note": "dotless i is already lowercase and stays"
    },
    {
      "id": "norm_text-013",
      "fn": "norm_text",
      "input": "\u041c\u041e\u0421\u041a\u0412\u0410",
      "expected": "\u043c\u043e\u0441\u043a\u0432\u0430",
      "note": "Cyrillic lowercases"
    },
    {
      "id": "norm_text-014",
