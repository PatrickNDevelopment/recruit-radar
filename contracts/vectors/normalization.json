      "id": "title_key-011",
      "fn": "title_key",
      "input": "()",
      "expected": "",
      "note": "empty parentheses"
    },
    {
      "id": "title_key-012",
      "fn": "title_key",
      "input": "[ ]",
      "expected": "",
      "note": "blank brackets"
    },
    {
      "id": "title_key-013",
      "fn": "title_key",
      "input": "((()))",
      "expected": "",
      "note": "deeply nested empty parentheses"
    },
    {
      "id": "title_key-014",
      "fn": "title_key",
      "input": "Manager (Engineer track)",
      "expected": "manager",
      "note": "keyword inside brackets is invisible to matching"
    },
    {
      "id": "title_key-015",
      "fn": "title_key",
      "input": "Engineer\uff08Remote\uff09",
      "expected": "engineer remote",
      "note": "fullwidth brackets are NOT removed (removal precedes NFKC); NFKC then separates"
    },
    {
      "id": "title_key-016",
      "fn": "title_key",
      "input": "Engineer (Remote\nUS) II",
      "expected": "engineer ii",
      "note": "a bracketed segment may span a newline"
    },
    {
      "id": "title_key-017",
      "fn": "title_key",
      "input": "Engineer (A) (B) [C] [D]",
      "expected": "engineer",
      "note": "multiple adjacent segments"
    },
    {
      "id": "title_key-018",
      "fn": "title_key",
      "input": "Staff Engineer - (Platform)",
      "expected": "staff engineer",
      "note": "trailing parenthetical after a dash"
    },
    {
      "id": "title_key-019",
      "fn": "title_key",
      "input": "(Remote) Engineer",
      "expected": "engineer",
      "note": "leading parenthetical"
    },
    {
      "id": "title_key-020",
      "fn": "title_key",
      "input": "Sr. Software Engineer, Backend (Remote, US)",
      "expected": "sr software engineer backend",
      "note": "commas and periods"
    },
    {
      "id": "title_key-021",
      "fn": "title_key",
      "input": "C++ Developer (Games)",
      "expected": "c developer",
      "note": "symbols plus bracket removal"
    },
    {
      "id": "title_key-022",
      "fn": "title_key",
      "input": "\u30a8\u30f3\u30b8\u30cb\u30a2\uff08\u30ea\u30e2\u30fc\u30c8\uff09",
      "expected": "\u30a8\u30f3\u30b8\u30cb\u30a2 \u30ea\u30e2\u30fc\u30c8",
      "note": "CJK title with fullwidth parentheses survives"
    },
    {
      "id": "title_key-023",
      "fn": "title_key",
      "input": "Engineer )(",
      "expected": "engineer",
      "note": "reversed parentheses are not a segment"
    },
    {
      "id": "title_key-024",
      "fn": "title_key",
      "input": "",
      "expected": "",
      "note": "empty title"
    },
    {
      "id": "location_key-001",
      "fn": "location_key",
      "input": "New York, NY",
      "expected": "new ny york",
      "note": "spec example"
    },
    {
      "id": "location_key-002",
      "fn": "location_key",
      "input": "NY - New York",
      "expected": "new ny york",
      "note": "spec example: token order does not matter"
    },
    {
      "id": "location_key-003",
      "fn": "location_key",
      "input": null,
      "expected": "",
      "note": "null location is treated as empty"
    },
    {
      "id": "location_key-004",
      "fn": "location_key",
      "input": "",
      "expected": "",
      "note": "empty location"
    },
    {
      "id": "location_key-005",
      "fn": "location_key",
      "input": "Remote",
      "expected": "remote",
      "note": "single token"
    },
    {
      "id": "location_key-006",
      "fn": "location_key",
      "input": "NY NY New York",
      "expected": "new ny york",
      "note": "duplicate tokens collapse"
    },
    {
      "id": "location_key-007",
      "fn": "location_key",
      "input": "Z\u00fcrich, Switzerland",
      "expected": "switzerland z\u00fcrich",
      "note": "'s' sorts before 'z-umlaut' by code point"
    },
    {
      "id": "location_key-008",
      "fn": "location_key",
      "input": "\u00e9cole zebra",
      "expected": "zebra \u00e9cole",
      "note": "code point order puts e-acute (U+E9) AFTER z; locale collation would not"
    },
    {
      "id": "location_key-009",
      "fn": "location_key",
      "input": "10 Downing St",
      "expected": "10 downing st",
      "note": "digits sort before letters"
    },
    {
      "id": "location_key-010",
      "fn": "location_key",
      "input": "\ud840\udc00 \u2764\ufe0f",
      "expected": "\ufe0f \ud840\udc00",
      "note": "U+FE0F (BMP) sorts BEFORE U+20000 (astral) by code point; UTF-16 unit order says the opposite"
    },
    {
      "id": "location_key-011",
      "fn": "location_key",
      "input": "Berlin, Germany; Munich, Germany",
      "expected": "berlin germany munich",
      "note": "semicolon separates, duplicates collapse"
    },
    {
      "id": "location_key-012",
      "fn": "location_key",
      "input": "San Francisco Bay Area (Hybrid)",
      "expected": "area bay francisco hybrid san",
      "note": "brackets are NOT removed in location_key"
    },
    {
      "id": "location_key-013",
      "fn": "location_key",
      "input": "\uff2e\uff39",
      "expected": "ny",
      "note": "fullwidth letters fold"
    },
    {
      "id": "location_key-014",
      "fn": "location_key",
      "input": "Remote - US / Canada",
      "expected": "canada remote us",
      "note": "slash and dash separate"
    },
    {
      "id": "location_key-015",
      "fn": "location_key",
      "input": "\u6771\u4eac \u65e5\u672c",
      "expected": "\u65e5\u672c \u6771\u4eac",
      "note": "CJK tokens sort by code point (U+65E5 < U+6771)"
    },
    {
      "id": "location_key-016",
      "fn": "location_key",
      "input": "a b A B",
      "expected": "a b",
      "note": "case-folded duplicates collapse"
    },
    {
      "id": "location_key-017",
      "fn": "location_key",
      "input": "\u00c5rhus, \u00d8stergade",
      "expected": "\u00e5rhus \u00f8stergade",
      "note": "a-ring (U+E5) before o-slash (U+F8)"
    },
    {
      "id": "location_key-018",
      "fn": "location_key",
      "input": "Remote (US)",
      "expected": "remote us",
      "note": "parenthetical stays as tokens"
    },
    {
      "id": "token_sequence_match-001",
      "fn": "token_sequence_match",
      "input": { "title": "senior data engineer", "phrase": "data engineer" },
      "expected": true,
      "note": "contiguous multi-token phrase"
    },
    {
      "id": "token_sequence_match-002",
      "fn": "token_sequence_match",
      "input": { "title": "data software engineer", "phrase": "data engineer" },
      "expected": false,
      "note": "same tokens, not contiguous"
    },
    {
      "id": "token_sequence_match-003",
      "fn": "token_sequence_match",
      "input": { "title": "engineering manager", "phrase": "engineer" },
      "expected": false,
      "note": "token must match whole token, not a prefix"
    },
    {
      "id": "token_sequence_match-004",
      "fn": "token_sequence_match",
      "input": { "title": "engineer", "phrase": "engineer" },
      "expected": true,
      "note": "exact"
    },
    {
      "id": "token_sequence_match-005",
      "fn": "token_sequence_match",
      "input": { "title": "senior engineer", "phrase": "Engineer" },
      "expected": true,
      "note": "phrase is normalized (case)"
    },
    {
      "id": "token_sequence_match-006",
      "fn": "token_sequence_match",
      "input": { "title": "senior engineer", "phrase": "" },
      "expected": false,
      "note": "empty phrase never matches"
    },
    {
      "id": "token_sequence_match-007",
      "fn": "token_sequence_match",
      "input": { "title": "senior engineer", "phrase": "!!!" },
      "expected": false,
      "note": "phrase that normalizes to empty never matches"
    },
    {
      "id": "token_sequence_match-008",
      "fn": "token_sequence_match",
      "input": { "title": "engineer", "phrase": "senior engineer" },
      "expected": false,
      "note": "phrase longer than title"
    },
    {
      "id": "token_sequence_match-009",
      "fn": "token_sequence_match",
      "input": { "title": "c developer", "phrase": "C++" },
      "expected": true,
      "note": "'C++' normalizes to token 'c'"
    },
    {
      "id": "token_sequence_match-010",
      "fn": "token_sequence_match",
      "input": { "title": "objective c developer", "phrase": "C#" },
      "expected": true,
      "note": "'c' matches inside an unrelated title"
    },
    {
      "id": "token_sequence_match-011",
      "fn": "token_sequence_match",
      "input": { "title": "a b a b", "phrase": "b a" },
      "expected": true,
      "note": "match found at an inner offset"
    },
    {
      "id": "token_sequence_match-012",
      "fn": "token_sequence_match",
      "input": { "title": "a b a b", "phrase": "a a" },
      "expected": false,
      "note": "tokens exist but are not adjacent"
    },
    {
      "id": "token_sequence_match-013",
      "fn": "token_sequence_match",
      "input": { "title": "machine learning researcher", "phrase": "machine learning" },
      "expected": true,
      "note": "two-token phrase"
    },
    {
      "id": "token_sequence_match-014",
      "fn": "token_sequence_match",
      "input": { "title": "learning machine operator", "phrase": "machine learning" },
      "expected": false,
      "note": "order matters"
    },
    {
      "id": "token_sequence_match-015",
      "fn": "token_sequence_match",
      "input": { "title": "internal tools engineer", "phrase": "intern" },
      "expected": false,
      "note": "'intern' must not match 'internal'"
    },
    {
      "id": "token_sequence_match-016",
      "fn": "token_sequence_match",
      "input": { "title": "engineer intern", "phrase": "intern" },
      "expected": true,
      "note": "'intern' matches as a whole token"
    },
    {
      "id": "token_sequence_match-017",
      "fn": "token_sequence_match",
      "input": { "title": "caf\u00e9 manager", "phrase": "CAFE\u0301" },
      "expected": true,
      "note": "phrase NFKC-composes before comparison"
    },
    {
      "id": "token_sequence_match-018",
      "fn": "token_sequence_match",
      "input": { "title": "stra\u00dfe lead", "phrase": "STRASSE" },
      "expected": false,
      "note": "sharp s is not ss"
    },
    {
      "id": "token_sequence_match-019",
      "fn": "token_sequence_match",
      "input": { "title": "", "phrase": "engineer" },
      "expected": false,
      "note": "empty title key"
    },
    {
      "id": "token_sequence_match-020",
      "fn": "token_sequence_match",
      "input": { "title": "", "phrase": "" },
      "expected": false,
      "note": "both empty"
    },
    {
      "id": "token_sequence_match-021",
      "fn": "token_sequence_match",
      "input": { "title": "lead engineer ii", "phrase": "lead  ENGINEER" },
      "expected": true,
      "note": "internal whitespace and case in the phrase"
    },
    {
      "id": "token_sequence_match-022",
      "fn": "token_sequence_match",
      "input": { "title": "front end engineer", "phrase": "front-end" },
      "expected": true,
      "note": "hyphenated phrase becomes two tokens"
    },
    {
      "id": "token_sequence_match-023",
      "fn": "token_sequence_match",
      "input": { "title": "frontend engineer", "phrase": "front-end" },
      "expected": false,
      "note": "fused word does not match split phrase"
    },
    {
      "id": "token_sequence_match-024",
      "fn": "token_sequence_match",
      "input": { "title": "sr software engineer", "phrase": "Sr. Software" },
      "expected": true,
      "note": "punctuation in phrase"
    },
    {
      "id": "token_sequence_match-025",
      "fn": "token_sequence_match",
      "input": { "title": "\u682a\u5f0f\u4f1a\u793e", "phrase": "\u682a\u5f0f" },
      "expected": false,
      "note": "CJK token is whole-token matched"
    },
    {
      "id": "token_sequence_match-026",
      "fn": "token_sequence_match",
      "input": { "title": "engineer", "phrase": "engineer engineer" },
      "expected": false,
      "note": "repeated phrase tokens need repeated title tokens"
    },
    {
      "id": "sha12-001",
      "fn": "sha12",
      "input": "",
      "expected": "e3b0c44298fc",
      "note": "SHA-256 of the empty string starts e3b0c44298fc"
    },
    {
      "id": "sha12-002",
      "fn": "sha12",
      "input": "abc",
      "expected": "ba7816bf8f01",
      "note": "SHA-256 of 'abc' starts ba7816bf8f01"
    },
    {
      "id": "sha12-003",
      "fn": "sha12",
      "input": "acme",
      "expected": "822b33ad87c1",
      "note": "company key as hashed for company_id"
    },
    {
      "id": "sha12-004",
      "fn": "sha12",
      "input": "Acme",
      "expected": "37036cd8f974",
      "note": "case-sensitive: differs from 'acme'"
    },
    {
      "id": "sha12-005",
      "fn": "sha12",
      "input": "acme|acme robotics",
      "expected": "222aa4deb8b9",
      "note": "candidate_id preimage uses '|'"
    },
    {
      "id": "sha12-006",
      "fn": "sha12",
      "input": "\u00e9",
      "expected": "4a99557e4033",
      "note": "precomposed e-acute: UTF-8 bytes C3 A9, no normalization"
    },
    {
      "id": "sha12-007",
      "fn": "sha12",
      "input": "e\u0301",
      "expected": "bf12767b0f2a",
      "note": "decomposed e-acute differs from the precomposed hash (sha12 does NOT normalize)"
    },
    {
      "id": "sha12-008",
      "fn": "sha12",
      "input": "\ud83d\ude80",
      "expected": "ebbc0b2870eb",
      "note": "astral code point hashes its 4 UTF-8 bytes"
    },
    {
      "id": "sha12-009",
      "fn": "sha12",
      "input": "c_acme",
      "expected": "da516c92e366",
      "note": "prefix is not part of the digest"
    },
    {
      "id": "sha12-010",
      "fn": "sha12",
      "input": "",
      "expected": "41edece42d63",
      "note": "long input"
    },
    {
      "id": "sha12-011",
      "fn": "sha12",
      "input": "\u682a\u5f0f\u4f1a\u793e",
      "expected": "e6843c6eb529",
      "note": "CJK, 12 UTF-8 bytes"
    }
  ]
}
