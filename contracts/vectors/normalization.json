{
  "format_version": 1,
  "kind": "normalization",
  "description": "Golden cases for the 01-normalization-and-identity functions. See README.md.",
  "cases": [
    {
      "id": "norm_text-001",
      "fn": "norm_text",
      "input": "Hello World",
      "expected": "hello world",
      "note": "plain ASCII, lowercase"
    },
    {
      "id": "norm_text-002",
      "fn": "norm_text",
      "input": "  Multiple   spaces\t\ttabs\r\nand\nnewlines  ",
      "expected": "multiple spaces tabs and newlines",
      "note": "mixed whitespace collapses to single spaces, ends trimmed"
    },
    {
      "id": "norm_text-003",
      "fn": "norm_text",
      "input": "a\u00a0b\u2003c\u3000d",
      "expected": "a b c d",
      "note": "NBSP, em space, ideographic space are separators"
    },
    {
      "id": "norm_text-004",
      "fn": "norm_text",
      "input": "\uff21\uff23\uff2d\uff25\u3000\uff11\uff12\uff13",
      "expected": "acme 123",
      "note": "fullwidth Latin, space and digits fold under NFKC"
    },
    {
      "id": "norm_text-005",
      "fn": "norm_text",
      "input": "Caf\u00e9",
      "expected": "caf\u00e9",
      "note": "precomposed accent preserved (not stripped)"
    },
    {
      "id": "norm_text-006",
      "fn": "norm_text",
      "input": "Cafe\u0301",
      "expected": "caf\u00e9",
      "note": "decomposed e + U+0301 composes under NFKC"
    },
    {
      "id": "norm_text-007",
      "fn": "norm_text",
      "input": "Stra\u00dfe",
      "expected": "stra\u00dfe",
      "note": "sharp s is not casefolded to ss"
    },
    {
      "id": "norm_text-008",
      "fn": "norm_text",
      "input": "STRASSE",
      "expected": "strasse",
      "note": "ASCII SS stays ss, so differs from the sharp-s spelling"
    },
    {
      "id": "norm_text-009",
      "fn": "norm_text",
      "input": "STRA\u1e9eE",
      "expected": "stra\u00dfe",
      "note": "capital sharp s lowercases to sharp s"
    },
    {
      "id": "norm_text-010",
      "fn": "norm_text",
      "input": "\u0130stanbul",
      "expected": "i\u0307stanbul",
      "note": "Turkish dotted capital I -> i + U+0307 (kept: category Mn)"
    },
    {
      "id": "norm_text-011",
      "fn": "norm_text",
      "input": "ISTANBUL",
      "expected": "istanbul",
      "note": "plain I lowercases to i, not dotless i (locale-free)"
